// The game window's icon (d3d.c window_thread): the launcher's seal, from the host DLL, since onimusha.exe keeps its
// image layout fixed around the Xbox executable.
1 ICON "../../launcher/app.ico"
// Kabuto Sans (tools/font): enhanced_text and the overlays draw with it (text.c kabuto_font). Its licences ship in
// bin\licenses\.
2 RCDATA "../../tools/font/KabutoSans.ttf"
#include <winver.h>
#define ONI_FILE_DESC "Genma Onimusha runtime"
#define ONI_FILE_NAME "onimusha_host.dll"
#define ONI_FILE_TYPE VFT_DLL
#include "../../launcher/version.rc2"
